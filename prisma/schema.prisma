generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =======================
// AUTENTICACIÓN (NEXTAUTH PRISMA ADAPTER)
// =======================

model User {
  id            String       @id @default(cuid())
  name          String?      // Nombre completo o display name
  email         String?      @unique
  emailVerified DateTime?
  image         String?      // Avatar URL
  username      String?      @unique
  passwordHash  String?      // Contraseña con hash bcryptjs
  bio           String?      @default("Explorador y analista del catálogo universal.")
  totalXp       Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  accounts      Account[]
  sessions      Session[]
  userMovies    UserMovie[]
  userSeries    UserSeries[]
  userGames     UserGame[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =======================
// MODELOS DE CINE
// =======================

model Movie {
  id                 String      @id @default(cuid())
  tmdbId             Int         @unique
  imdbId             String?
  title              String
  originalTitle      String?
  year               Int?
  posterPath         String?
  backdropPath       String?
  overview           String?
  runtime            Int?
  genres             String      // JSON array de strings
  director           String?
  directorImage      String?
  cast               String      // JSON array de { name, character, profilePath }
  imdbRating         Float?
  streamingPlatforms String?     // JSON array de plataformas
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  userMovies         UserMovie[]
}

model UserMovie {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId       String
  movie         Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  status        String    // "WATCHLIST" | "WATCHED"
  userRating    Float?    // 0.0 a 10.0
  review        String?
  watchedDate   DateTime?
  platform      String?   // "Netflix" | "HBO Max" | "Prime Video" | "Disney+" | "Pirata"
  ballKnowledge Float?    // 0 a 100 percentage
  difference    Float?    // userRating - imdbRating
  isFavorite    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, movieId])
}

model UserProfile {
  id          String   @id @default("user-default")
  displayName String   @default("Cinéfilo")
  avatarUrl   String?
  bio         String?  @default("Explorador y analista del séptimo arte.")
  totalXp     Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// =======================
// MODELOS DE SERIES DE TV
// =======================

model Series {
  id                 String      @id @default(cuid())
  tmdbId             Int         @unique
  imdbId             String?
  name               String
  originalName       String?
  firstAirYear       Int?
  lastAirYear        Int?
  numberOfSeasons    Int?
  numberOfEpisodes   Int?
  seriesStatus       String?     // "Returning Series", "Ended", etc.
  posterPath         String?
  backdropPath       String?
  overview           String?
  genres             String      // JSON array de strings
  creator            String?
  creatorImage       String?
  cast               String      // JSON array de { id, name, character, profilePath }
  imdbRating         Float?
  streamingPlatforms String?     // JSON array de plataformas
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  userSeries         UserSeries[]
}

model UserSeries {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId      String
  series        Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  status        String    // "WATCHLIST" | "WATCHED"
  userRating    Float?    // 0.0 a 10.0
  review        String?
  watchedDate   DateTime?
  platform      String?   // "Netflix" | "HBO Max" | "Prime Video" | "Disney+" | "Pirata"
  ballKnowledge Float?    // 0 a 100 percentage
  difference    Float?    // userRating - imdbRating
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, seriesId])
}

// =======================
// MODELOS DE VIDEOJUEGOS
// =======================

model Game {
  id              String      @id @default(cuid())
  rawgId          Int         @unique
  title           String
  released        String?
  backgroundImage String?
  metacritic      Int?        // 0 a 100 (ej. 92)
  rating          Float?      // RAWG rating 0 a 5
  genres          String      // JSON array
  platforms       String      // JSON array de nombres (PC, PlayStation 5, Nintendo Switch, etc.)
  developers      String?     // JSON array
  publishers      String?     // JSON array
  description     String?
  screenshots     String?     // JSON array de URLs
  trailerUrl      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  userGames       UserGame[]
}

model UserGame {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId          String
  game            Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  status          String    // "BACKLOG" | "PLAYING" | "COMPLETED" | "PLATINUM" | "DROPPED"
  userRating      Float?    // 0.0 a 10.0
  hoursPlayed     Float?    // Horas registradas (ej. 127)
  platform        String?   // Plataforma donde lo jugó (ej. "PC", "PS5", "Switch")
  platformDetails String?   // JSON array de { platform, hours, status }
  review          String?
  completedDate   DateTime?
  gameKnowledge   Float?    // 0 a 100 percentage
  difference      Float?    // userRating - (metacritic / 10)
  isFavorite      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, gameId])
}

model GamerProfile {
  id          String   @id @default("gamer-default")
  displayName String   @default("Gamer")
  avatarUrl   String?
  bio         String?  @default("Jugador y explorador de mundos virtuales.")
  totalXp     Int      @default(0)
  updatedAt   DateTime @updatedAt
}
